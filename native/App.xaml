<Application
    x:Class="HybridIntelligenceStudio.ShowcaseApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#0F6CBD</Color>
            <Color x:Key="SystemAccentColorLight1">#2B7FC9</Color>
            <Color x:Key="SystemAccentColorLight2">#4A94D3</Color>
            <Color x:Key="SystemAccentColorLight3">#8CBCE6</Color>
            <Color x:Key="SystemAccentColorDark1">#0E5FA8</Color>
            <Color x:Key="SystemAccentColorDark2">#0C4E8A</Color>
            <Color x:Key="SystemAccentColorDark3">#093A66</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
