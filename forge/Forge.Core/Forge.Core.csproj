<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that turns a brief into a deck without touching a model: the shape IR, layouts, the PPTX and PNG
       writers, lint/grade and the prompt harness over an ILlm. No Foundry Local and no device kit in here, so it
       tests headless. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <RootNamespace>Forge.Core</RootNamespace>
    <AssemblyName>Forge.Core</AssemblyName>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\*.json" LogicalName="Forge.Core.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Data\briefs\*.json" LogicalName="Forge.Core.briefs.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
