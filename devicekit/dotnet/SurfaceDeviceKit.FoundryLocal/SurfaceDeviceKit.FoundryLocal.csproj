<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <RootNamespace>SurfaceDeviceKit.FoundryLocal</RootNamespace>
    <AssemblyName>SurfaceDeviceKit.FoundryLocal</AssemblyName>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AI.Foundry.Local" Version="2.1.0" />
    <ProjectReference Include="..\SurfaceDeviceKit\SurfaceDeviceKit.csproj" />
  </ItemGroup>

</Project>
