<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Offline PPTX Forge as an isolated WinUI 3 app: it needs no Studio, no Python and no server. Everything it does goes through
       Forge.Engine (the same ForgeSession the command line drives), so what the window shows is what forge-cli prints.
       Self-contained and unpackaged, for ARM64 (Snapdragon, NVIDIA RTX Spark) and x64 (Intel, AMD, NVIDIA).
         dotnet build -c Release -r win-arm64 -p:Platform=ARM64
         dotnet build -c Release -r win-x64   -p:Platform=x64
       With no -r the build matches the PC it runs on. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableCoreMrtTooling>true</EnableCoreMrtTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OfflinePptxForge</AssemblyName>
    <RootNamespace>OfflinePptxForge</RootNamespace>
    <Product>Offline PPTX Forge</Product>
    <AssemblyTitle>Offline PPTX Forge</AssemblyTitle>
    <Version>2.0.0</Version>
    <!-- The chip family this package is for: snapdragon, intel, nvidia or any. forge\tools\Build-ForgePackages.ps1 sets it per package, and the
         app tells the presenter when it runs on a different family. Detection and model planning never depend on it. -->
    <ForgeSilicon Condition="'$(ForgeSilicon)' == ''">any</ForgeSilicon>
    <NoWarn>$(NoWarn);CA1416;NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ForgeSilicon" Value="$(ForgeSilicon)" />
  </ItemGroup>

  <!-- No -r and no Platform: build for the architecture of this PC. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' != 'Arm64'">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
    <PlatformTarget>ARM64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('Assets\AppIcon.ico')">
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\**" />
    <Content Remove="Assets\**" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Forge.Engine\Forge.Engine.csproj" />
  </ItemGroup>

  <!-- Unpackaged publish leaves out the app's own resource index and compiled XAML, and without them App.xaml fails at startup. -->
  <Target Name="ForgePublishXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <ForgeXamlResource Include="$(OutDir)$(TargetName).pri" />
      <ForgeXamlResource Include="$(OutDir)**\*.xbf" />
    </ItemGroup>
    <Error Condition="!Exists('$(OutDir)$(TargetName).pri')" Text="$(TargetName).pri was not generated in $(OutDir)." />
    <Copy SourceFiles="@(ForgeXamlResource)" DestinationFiles="@(ForgeXamlResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
