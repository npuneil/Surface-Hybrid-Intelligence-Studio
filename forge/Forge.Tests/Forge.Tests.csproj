<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console test runner for Forge.Core and Forge.Engine. No external test framework: each area is a static class with Run() returning the
       number of failures, and Program prints a summary and exits non-zero on any failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <RootNamespace>Forge.Tests</RootNamespace>
    <AssemblyName>forge-tests</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Forge.Core\Forge.Core.csproj" />
    <ProjectReference Include="..\Forge.Engine\Forge.Engine.csproj" />
    <!-- Validator only: nothing that ships references the Open XML SDK. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="fixtures" />
  </ItemGroup>

</Project>
