<Application
    x:Class="HybridIntelligenceStudio.ShowcaseApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#1F4E79</Color>
            <Color x:Key="SystemAccentColorLight1">#2B6CA3</Color>
            <Color x:Key="SystemAccentColorLight2">#5A8FC2</Color>
            <Color x:Key="SystemAccentColorLight3">#A9C6E3</Color>
            <Color x:Key="SystemAccentColorDark1">#1A4268</Color>
            <Color x:Key="SystemAccentColorDark2">#153655</Color>
            <Color x:Key="SystemAccentColorDark3">#0F2740</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
